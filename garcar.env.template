# Garcar Enterprise Master Orchestration – Environment Template
# Copy to .env and fill in real values:
#   cp garcar.env.template .env && nano .env
#
# Then load:
#   export $(grep -v '^#' .env | xargs)
#
# Every module gracefully skips when its token is missing.

# ---------------------------------------------------------------------------
# GitHub
# ---------------------------------------------------------------------------
# Personal Access Token (classic) or fine-grained token with:
#   repo, workflow, actions:write, read:org
GITHUB_TOKEN=

# Optional – organisation that owns the core repos
# Leave blank to use the authenticated user
GITHUB_ORG=

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
# Secret key (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Linear
# ---------------------------------------------------------------------------
# API key from Linear → Settings → API → Personal API keys
LINEAR_API_KEY=

# ---------------------------------------------------------------------------
# Notion
# ---------------------------------------------------------------------------
# Internal integration token
NOTION_TOKEN=

# Database ID of your “Command Log” database
# (from the URL: notion.so/...?v=... → the 32-char ID)
NOTION_DATABASE_ID=

# ---------------------------------------------------------------------------
# Slack
# ---------------------------------------------------------------------------
# Incoming Webhook URL
SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Optional future modules (already respected by the script)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DISCORD_WEBHOOK_URL=
